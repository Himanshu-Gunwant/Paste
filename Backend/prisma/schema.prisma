// Pastebin platform backend — Prisma schema.
//
// Per the approved architecture (docs/ARCHITECTURE.md §19), migrations ship PER
// PHASE — this schema grows as phases are implemented, and never contains
// models for unimplemented modules:
//
//   Phase 1 (shipped): User, Session, OAuthAccount, AuthToken
//   Phase 2 (shipped): Paste, PasteRevision, PasteViewDaily, PasteToken
//            (+ raw SQL migration with partial indexes — stable predicates
//            only; expiry filtering exclusively via query WHERE clauses)
//   Phase 3: (no new tables — revisions land with Paste in Phase 2)
//   Phase 4: raw SQL migration 002_search_vector.sql (tsvector + GIN)
//   Phase 5: ApiKey, ApiUsage
//   Phase 6: Collection, CollectionPaste, Bookmark
//   Phase 8: AbuseReport, AuditLog, UserRestriction, IpBan
//
// Key contract points (docs/ARCHITECTURE.md §5):
//   - Paste.content is nullable with the tombstone invariant:
//     non-null iff deleted_at IS NULL (tombstoning nulls it in the same tx).
//   - PasteToken unifies SHARE/MANAGEMENT tokens; token hashes are stored in
//     PostgreSQL and are authoritative; Redis is an optional read-through cache.
//   - expires_at IS NULL means "never expires".

// New prisma-client generator (Prisma 7): emits TypeScript ESM sources into
// src/generated/prisma (gitignored; `prisma generate` runs on postinstall/CI).
// Runtime queries go through the @prisma/adapter-pg driver adapter — no
// native query engine (docs/ARCHITECTURE.md §3; DECISIONS.md D-002).
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---- Phase 1: Auth & users -------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique @db.VarChar(255) // lowercased at app layer
  emailVerified Boolean    @default(false) @map("email_verified")
  // NULL for OAuth-only accounts (docs/ARCHITECTURE.md §4 D)
  passwordHash  String?    @map("password_hash")
  username      String     @unique @db.VarChar(30) // immutable, reserved-word list
  displayName   String?    @map("display_name") @db.VarChar(80)
  bio           String?    @db.VarChar(280)
  avatarUrl     String?    @map("avatar_url")
  websiteUrl    String?    @map("website_url")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  // Denormalized byte counter maintained by services; nightly reconcile (§4 K)
  storageUsed   BigInt     @default(0) @map("storage_used")
  // Soft delete / anonymization (email → deleted+{id}@invalid on delete)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      Session[]
  oauthAccounts OAuthAccount[]
  authTokens    AuthToken[]
  pastes        Paste[]
  pasteTokensCreated PasteToken[] @relation("PasteTokenCreator")
  apiKeys       ApiKey[]

  @@map("users")
}

// Session token hash is the PK: one indexed lookup per authenticated request.
model Session {
  id         String   @id @db.VarChar(64) // SHA-256 hex of 32-byte session token
  userId     String   @map("user_id") @db.Uuid
  ip         String?  @db.VarChar(45) // user's own data, shown in sessions UI
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6) // rolling 30-day idle
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

// Unified single-use email tokens: EMAIL_VERIFICATION (24 h) / PASSWORD_RESET (1 h)
model AuthToken {
  id        String        @id @db.VarChar(64) // SHA-256 hex of token
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ---- Phase 2: Paste core ----------------------------------------------------

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum DeletedBy {
  USER
  MODERATOR
  SYSTEM
}

enum TokenPurpose {
  MANAGEMENT
  SHARE
}

// NOTE: custom_slug has NO @unique here — its UNIQUE constraint is a PARTIAL
// index (WHERE custom_slug IS NOT NULL) created by the raw-SQL migration with
// the other partial indexes (stable predicates only — never now(), §5.3).
model Paste {
  id               String     @id @db.VarChar(64) // 10-char short id OR custom slug (≤64)
  authorId         String?    @map("author_id") @db.Uuid // NULL = anonymous paste
  customSlug       String?    @map("custom_slug") @db.VarChar(64)
  title            String?    @db.VarChar(140)
  description      String?    @db.VarChar(500)
  language         String?    @db.VarChar(50) // user-declared
  detectedLanguage String?    @map("detected_language") @db.VarChar(50) // heuristic
  // Tombstone invariant: non-null iff deleted_at IS NULL (tombstoning nulls
  // it in the same tx as deleted_at — docs/ARCHITECTURE.md §5.2).
  content          String?    @db.Text
  contentSize      Int        @map("content_size") // original bytes, kept after tombstoning
  contentHash      String     @map("content_hash") @db.VarChar(64) // SHA-256
  visibility       Visibility @default(PUBLIC)
  passwordHash     String?    @map("password_hash") // Argon2id (lighter params than login)
  maxViews         Int?       @map("max_views") // synchronous enforcement (exact)
  viewCount        BigInt     @default(0) @map("view_count") // Redis-buffered flush
  burnAfterRead    Boolean    @default(false) @map("burn_after_read")
  burnedAt         DateTime?  @map("burned_at") @db.Timestamptz(6)
  // NULL = never expires; read-path filter: (expires_at IS NULL OR expires_at > now())
  expiresAt        DateTime?  @map("expires_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy        DeletedBy? @map("deleted_by")
  forkOfId         String?    @map("fork_of_id") @db.VarChar(64)
  // Generated tsvector (migration 20261105090000) — not exposed via the
  // client; queried through parameterized raw SQL in search.service.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  latestRevisionNo Int        @default(1) @map("latest_revision_no")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  author      User?         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  forkOf      Paste?        @relation("ForkSource", fields: [forkOfId], references: [id], onDelete: SetNull)
  forks       Paste[]       @relation("ForkSource")
  revisions   PasteRevision[]
  viewDaily   PasteViewDaily[]
  pasteTokens PasteToken[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([visibility, language, createdAt(sort: Desc)])
  @@index([contentHash])
  @@map("pastes")
}

// Full content snapshots, capped (drop-oldest) — docs/ARCHITECTURE.md §4 E.
model PasteRevision {
  id          String   @id @default(uuid(7)) @db.Uuid
  pasteId     String   @map("paste_id") @db.VarChar(64)
  revisionNo  Int      @map("revision_no")
  title       String?  @db.VarChar(140)
  description String?  @db.VarChar(500)
  language    String?  @db.VarChar(50)
  content     String   @db.Text
  contentSize Int      @map("content_size")
  editorId    String?  @map("editor_id") @db.Uuid // NULL for anon/management-token edits
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paste Paste @relation(fields: [pasteId], references: [id], onDelete: Cascade)

  @@unique([pasteId, revisionNo])
  @@map("paste_revisions")
}

// Aggregated analytics — no raw per-view table; uniques come from Redis HLL.
model PasteViewDaily {
  pasteId        String   @map("paste_id") @db.VarChar(64)
  day            DateTime @db.Date
  views          BigInt   @default(0)
  uniqueVisitors BigInt   @default(0) @map("unique_visitors")

  paste Paste @relation(fields: [pasteId], references: [id], onDelete: Cascade)

  @@id([pasteId, day])
  @@map("paste_view_daily")
}

// Unified paste-scoped bearer tokens: anonymous MANAGEMENT credentials and
// SHARE links. Hash in PostgreSQL is authoritative; Redis mgmt:{pasteId} is
// an optional read-through cache only (docs/ARCHITECTURE.md §4 B).
model PasteToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  pasteId   String       @map("paste_id") @db.VarChar(64)
  tokenHash String       @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex; raw shown once
  purpose   TokenPurpose
  createdBy String?      @map("created_by") @db.Uuid // NULL for anonymous management tokens
  // NULL = valid while the paste exists (mirrors paste TTL when set)
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(6)
  maxUses   Int?         @map("max_uses")
  useCount  Int          @default(0) @map("use_count")
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  paste         Paste @relation(fields: [pasteId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("PasteTokenCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([pasteId, purpose])
  @@map("paste_tokens")
}

// ---- Phase 5: Developer API --------------------------------------------------

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(80)
  prefix     String    @db.VarChar(12) // display only — raw key shown once at creation
  keyHash    String    @unique @map("key_hash") @db.VarChar(64) // SHA-256 hex
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage ApiUsage[]

  @@index([userId])
  @@map("api_keys")
}

// Append-only request log — 90-day retention, partitioned later if needed (§18).
model ApiUsage {
  id        BigInt   @id @default(autoincrement())
  apiKeyId  String?  @map("api_key_id") @db.Uuid // SET NULL: usage survives key deletion
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @db.VarChar(120)
  method    String   @db.VarChar(8)
  statusCode Int     @map("status_code")
  latencyMs Int      @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("api_usage")
}
