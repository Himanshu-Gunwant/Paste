# --- Core (required) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://paste:CHANGE_ME@localhost:5432/paste?schema=public
REDIS_URL=redis://localhost:6379

# Number of trusted reverse-proxy hops in front of the app (Nginx = 1).
TRUST_PROXY=1

# --- CORS ---
# Browser origin allowed to call the API with cookies. Unset = no CORS headers.
FRONTEND_ORIGIN=

# --- Secrets (Phase 1) ---
# 32+ bytes of CSPRNG entropy, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
COOKIE_KEYS=

# --- OAuth (Phase 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Phase 1) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Paste <no-reply@example.com>"

# --- CAPTCHA (Phase 8) ---
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Error tracking (Phase 9) ---
SENTRY_DSN=
